* text=auto
*.py text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.csv -text
*.tsv -text
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.svg text eol=lf
*.txt text eol=lf
*.srt text eol=lf
*.sh text eol=lf
*.command text eol=lf
*.prompt text eol=lf
*.lock text eol=lf
# Preserve the bytes of archived/raw payloads; no newline conversion.
data/raw/** -text
# Large saved payloads and compressed full-text tables.
*.gz filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.jsonl filter=lfs diff=lfs merge=lfs -text
*.pkl filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.m4a filter=lfs diff=lfs merge=lfs -text

# Browser datasets remain ordinary Git files.
app/data/*.gz -filter -diff -merge -text
