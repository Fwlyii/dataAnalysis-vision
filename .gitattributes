# Large experiment inputs and model outputs are stored with Git LFS so a normal
# GitHub push does not create an oversized ordinary Git blob.
experiments/lost-in-the-middle/data/*.gz filter=lfs diff=lfs merge=lfs -text
experiments/lost-in-the-middle/derived/*.gz filter=lfs diff=lfs merge=lfs -text
# Preserve whitespace in quoted model responses, including Markdown code blocks.
experiments/lost-in-the-middle/docs/05-output-examples.md whitespace=-blank-at-eol
# Matplotlib emits significant multiline SVG path data with trailing spaces.
experiments/lost-in-the-middle/figures/*.svg whitespace=-blank-at-eol
